# Where the SQLite database and automatic backups are stored.
# Relative paths are resolved from the project folder. Default: ./data
DATA_DIR=./data

# Host names (besides localhost, 127.0.0.1 and [::1]) the app will answer to. Leave empty for normal use.
# Only set this if you deliberately expose the app, e.g. behind a trusted reverse proxy. The app has no login.
ALLOWED_HOSTS=
